{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["clusterID", "hubEndpoint", "image", "apiServer"],
  "properties": {
    "clusterID": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "hubEndpoint": {"type": "string", "pattern": "^https://"},
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "properties": {
        "repository": {"type": "string"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "identitySecret": {"type": "string"},
    "networkPolicy": {
      "type": "object",
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}},
      "additionalProperties": false
    },
    "hostAliases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ip", "hostnames"],
        "properties": {
          "ip": {"type": "string"},
          "hostnames": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9.-]+$"}}
        },
        "additionalProperties": false
      }
    },
    "apiServer": {
      "type": "object",
      "required": ["cidrs", "port"],
      "properties": {
        "cidrs": {"type": "array", "items": {"type": "string", "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/(?:[0-9]|[12][0-9]|3[0-2])$"}},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "ciliumPolicy": {
      "type": "object",
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    }
  },
  "additionalProperties": true
}
