    "gateway":{"type":"object","required":["peerBundleSecret","listener","service"],"properties":{"nodeSelector":{"type":"object","additionalProperties":{"type":"string"}},"publicAuthority":{"type":"object","additionalProperties":true},"peerBundleSecret":{"type":"string"},"listener":{"type":"object","required":["enabled","port","publicEndpoint","hostPort"],"properties":{"enabled":{"type":"boolean"},"port":{"type":"integer","minimum":1,"maximum":65535},"publicEndpoint":{"type":"string","pattern":"^$|^quic://"},"hostPort":{"type":"integer","minimum":0,"maximum":65535}}},"service":{"type":"object","required":["type"],"properties":{"type":{"type":"string","enum":["ClusterIP","LoadBalancer","NodePort"]}}},"sessions":{"type":"array","items":{"type":"object","required":["endpoint","expectedSPIFFEID"],"properties":{"endpoint":{"type":"string","pattern":"^quic://"},"expectedSPIFFEID":{"type":"string","pattern":"^spiffe://"}},"additionalProperties":false}},"imports":{"type":"array","items":{"type":"object","required":["listen","serviceIdentity","expectedSPIFFEID"],"properties":{"name":{"type":"string"},"port":{"type":"integer","minimum":1,"maximum":65535},"listen":{"type":"string"},"endpoint":{"type":"string"},"serviceIdentity":{"type":"string","pattern":"^spiffe://"},"expectedSPIFFEID":{"type":"string","pattern":"^spiffe://"},"sessionOnly":{"type":"boolean"}},"additionalProperties":true}}}},
